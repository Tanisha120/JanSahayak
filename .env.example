# ==============================================================================
# JanSahayak Environment Configuration
# ==============================================================================
# JanSahayak supports one configurable LLM provider.
# If no API key is provided, the application runs automatically in an explicitly
# labeled "Scripted Demo Mode" with deterministic offline intelligence.

# Option 1: Google Gemini (Recommended)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# Option 2: OpenAI (Alternative)
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini
